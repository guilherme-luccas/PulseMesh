# Deixe vazio para o simulador: iOS usa http://127.0.0.1:3333 e Android usa http://10.0.2.2:3333.
# No celular, use o IP do computador, por exemplo http://192.168.1.10:3333
EXPO_PUBLIC_API_BASE_URL=

# Chave do Maps SDK for Android. Sem ela o mapa do Android não abre. Exige um novo build.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
